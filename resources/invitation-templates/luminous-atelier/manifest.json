{
    "id": "luminous-atelier",
    "name": "Luminous Atelier",
    "version": "1.0.0",
    "event_types": ["wedding", "engagement"],
    "entry_view": "luminous-atelier.views.index",
    "preview": "preview.svg",
    "sections": ["opening", "hosts", "story", "events", "countdown", "gallery", "map", "calendar", "rsvp", "guestbook", "gifts", "livestream", "contacts", "sharing", "closing"],
    "settings_schema": {
        "accent_color": {"type": "color", "default": "#b79a67"},
        "motion": {"type": "select", "options": ["calm", "expressive", "off"], "default": "expressive"},
        "cover_video_enabled": {"type": "boolean", "default": true},
        "cover_video_desktop": {"type": "url", "default": null},
        "cover_video_mobile": {"type": "url", "default": null},
        "cover_poster_image": {"type": "url", "default": null},
        "cover_focal_x": {"type": "number", "min": 0, "max": 100, "default": 50},
        "cover_focal_y": {"type": "number", "min": 0, "max": 100, "default": 48},
        "cover_overlay_opacity": {"type": "number", "min": 30, "max": 78, "default": 54}
    }
}
