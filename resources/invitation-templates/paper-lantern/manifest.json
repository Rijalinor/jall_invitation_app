{
    "id": "paper-lantern",
    "name": "Paper Lantern",
    "version": "1.1.0",
    "event_types": ["wedding", "engagement"],
    "entry_view": "paper-lantern.views.index",
    "preview": "preview.svg",
    "sections": ["opening", "hosts", "events", "countdown", "story", "gallery", "map", "calendar", "rsvp", "guestbook", "gifts", "livestream", "contacts", "sharing", "closing"],
    "settings_schema": {
        "accent_color": {"type": "color", "default": "#d68b62"},
        "motion": {"type": "select", "options": ["calm", "expressive", "off"], "default": "calm"},
        "cover_video_enabled": {"type": "boolean", "default": true},
        "cover_video_desktop": {"type": "url", "default": null},
        "cover_video_mobile": {"type": "url", "default": null},
        "cover_poster_image": {"type": "url", "default": null},
        "cover_focal_x": {"type": "number", "min": 0, "max": 100, "default": 50},
        "cover_focal_y": {"type": "number", "min": 0, "max": 100, "default": 50},
        "cover_overlay_opacity": {"type": "number", "min": 0, "max": 90, "default": 48}
    }
}
